extends default

block content
  div.page_content
    label Add your Quote here:
    form(action='/addQuote', method='post')
      textarea(name='quoteText', rows='20', cols='60') Four score and twenty years ago...

      label Quote Source:
      input(type='text', name='quoteSource', value='Abraham Lincoln, Gettysburg Address')

      label What kind of text is your Quote?
      select(name='quoteTypeOptions')
        each type in quoteTypes
          option(value=type.quote_type_id)= type.type

      select(name='quoteGenreOptions')
        each genre in quoteGenres
          option(value=genre.quote_genre_id)= genre.genre

      label How did you find this Quote?
      label
        input(type='radio', name='foundBy', value='Found Myself')
        |  I found this quote myself
      label
        input(type='radio', name='foundBy', value='Found on Folio')
        |  I saw this quote shared on Folio
      label
        input(type='radio', name='foundBy', value='Found by Others')
        |  This quote was shared with me by others outside Folio

      label Add a tag to group and search your quotes how you would.
      input(type='text', name='tag', value='Favorite History Quotes', size='60')
      input(type='submit', value='Submit')
