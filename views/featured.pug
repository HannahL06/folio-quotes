extends default

block content
  div.page_content
    h2 Featured Quotes
    div.quote_grid.quote_grid_single
      each quote in dailyQuotes
        div.quote_card
          p.quote_text "#{quote.dq_text}"
          p.quote_source #{quote.source}
          hr
          p.quote_meta #{quote.dq_type} | #{quote.dq_genre} | #{quote.dq_date}

    if loggedIn
      h2 Your Quote of the Day
      if myDailyQuote
        div.quote_grid.quote_grid_single
          div.quote_card
            p.quote_text "#{myDailyQuote.quote_text}"
            p.quote_source #{myDailyQuote.source}
            hr
            p.quote_meta #{myDailyQuote.type} | #{myDailyQuote.genre} | #{myDailyQuote.tag}
            p.quote_author Added on #{myDailyQuote.created_at}
      else
        p.empty_state
          | You don't have any quotes yet.
          a(href='/quoteForm') Add your first one
          |  to see it here.