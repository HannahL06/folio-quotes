doctype html
html
  head
    title #{title}
    link(rel='stylesheet', href='/css/styles.css')
    meta(name="viewport" content="width=device-width, initial-scale=1")
  body
    main
        div.flex_container
            block header
                header.top_bar
                    a(href='/index').logo-link
                        img(src='/images/logo.png').logo
                    ul.navbar
                        li
                            a(href='/index') Home
                        li
                            a(href='/folio') Folio
                        li
                            a(href='/featured') Featured Quotes
                        li
                            a(href='/accounts') Accounts
                        li
                            a(href='/contact') Contact
                h1 #{title}
            block content
        block footer
          footer.site_footer
            p © 2026 Hannah Lichtman