extends default

block content
  div.page_content
    if message
      p= message
    if !loggedIn
      form(action='/loginResponse', method='post')
        label Username
        input(type='text', name='username')

        label Password
        input(type='password', name='password')

        input(type='submit', value='Submit')

      p.form_footer_link
        | Don't have an account?
        a(href='/register') Sign up
