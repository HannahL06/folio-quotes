extends default

block content
  div.page_content
    p See what everyone on Folio has saved. Search, filter, and discover new lines worth remembering.

    form(action='/browse', method='get').filter_bar
      input(type='text', name='search', placeholder='Search all quotes', value=filters.search)

      select(name='type')
        option(value='') All Types
        each type in quoteTypes
          option(value=type.quote_type_id selected=filters.type == type.quote_type_id)= type.type

      select(name='genre')
        option(value='') All Genres
        each genre in quoteGenres
          option(value=genre.quote_genre_id selected=filters.genre == genre.quote_genre_id)= genre.genre

      select(name='sort')
        option(value='newest' selected=filters.sort === 'newest' || !filters.sort) Newest First
        option(value='oldest' selected=filters.sort === 'oldest') Oldest First
        option(value='type' selected=filters.sort === 'type') Type (A-Z)
        option(value='genre' selected=filters.sort === 'genre') Genre (A-Z)
        option(value='likes' selected=filters.sort === 'likes') Most Liked

      input(type='submit', value='Apply')

    if posts.length === 0
      p.empty_state No quotes match your filters yet.

    div.quote_grid.browse_grid
      each post in posts
        div.quote_card.compact
          if loggedIn
            form(action='/like/' + post.post_id, method='post').heart_form
              button.heart_button(type='submit', class=post.liked_by_viewer ? 'liked' : '')
                span.heart_icon= post.liked_by_viewer ? '♥' : '♡'
                span.heart_count= post.like_count
          else
            span.heart_form.heart_static
              span.heart_icon ♡
              span.heart_count= post.like_count

          p.quote_text "#{post.quote_text}"
          p.quote_source #{post.source}
          hr
          p.quote_author Posted by #{post.posted_by_username}

          div.post_actions
            if loggedIn && !post.is_own_quote
              form(action='/foliate/' + post.post_id, method='post')
                if post.foliod_by_viewer
                  input(type='submit', value='In Your Folio (' + post.foliod_count + ')', disabled=true).foliate_button.foliated
                else
                  input(type='submit', value='+ Folio This (' + post.foliod_count + ')').foliate_button
            else
              span.post_stat + Folio'd #{post.foliod_count}

    p.add_quote_link
      if loggedIn
        a(href='/quoteForm') Add Your Own Quote
      else
        a(href='/register') Sign Up to Add Your Own
