extends default

block page_title

block content
  -
    var tabs = [
      { id: 'collect', label: 'Collect', text: 'Save any line worth keeping in a few seconds. Add the quote and where you found it, then tag it by type and genre so it is easy to find again.' },
      { id: 'organize', label: 'Organize', text: 'Search everything you have saved, or narrow it down by type, genre, or tag. Edit or delete a quote whenever you like.' },
      { id: 'discover', label: 'Discover', text: 'Browse what everyone else is saving and sort by the most loved lines. Every day Folio also picks a new quote to feature.' },
      { id: 'share', label: 'Share', text: 'Post a quote to Browse so others can read it and like it. Found a line you love on someone else\'s post? Add it to your own collection.' }
    ];
    var spotlight = featuredQuote || { dq_text: 'Not all those who wander are lost.', source: 'J.R.R. Tolkien, The Fellowship of the Ring', dq_type: 'Book', dq_genre: 'Inspirational' };

  section.hero_band.full_bleed
    div.hero_inner
      h1.hero_title What lines will you keep today?
      p.hero_subtitle Collect quotes from books, songs, speeches, and conversations. Tag them, search them, and share the ones worth sharing.
      div.hero_actions
        if loggedIn
          a(href='/folio').button_primary Go to Your Folio
        else
          a(href='/register').button_primary Start collecting
          a(href='/login').button_secondary Log in

    div.hero_quote.quote_card
      p.hero_quote_label Today's featured quote
      p.quote_text "#{spotlight.dq_text}"
      p.quote_source #{spotlight.source}

  section.tools
    h2.section_heading Tools to keep your best lines
    div.tab_pills(role='tablist')
      each tab, i in tabs
        button.tab_pill(type='button', role='tab', data-tab=tab.id, aria-selected=String(i === 0), class=i === 0 ? 'active' : '')= tab.label
    each tab, i in tabs
      div.tab_panel(id='panel-' + tab.id, role='tabpanel', hidden=i !== 0)
        p.tab_text= tab.text

  section.banner.banner_blue
    h2 All your quotes. All in one place.
    p Search, filter, and sort everything you have saved by type, genre, or tag, then edit or remove it whenever you like.
    a.button_dark(href=loggedIn ? '/folio' : '/register') Explore My Quotes

  section.banner.banner_green
    h2 A new quote, every single day.
    p Each day Folio features one line from the pages of literature, and one pulled from your own collection.
    a.button_dark(href='/featured') See today's quote

  section.final_cta
    h2 Start collecting with Folio
    if loggedIn
      a.button_dark(href='/quoteForm') Add a quote
    else
      a.button_dark(href='/register') Get started for free

  script.
    (function () {
      var pills = document.querySelectorAll('.tab_pill');
      var panels = document.querySelectorAll('.tab_panel');
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          pills.forEach(function (p) {
            var active = p === pill;
            p.classList.toggle('active', active);
            p.setAttribute('aria-selected', String(active));
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.id !== 'panel-' + pill.dataset.tab;
          });
        });
      });
    })();
