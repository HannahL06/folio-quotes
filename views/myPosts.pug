extends default

block content
  div.page_content
    p Quotes you've published to Browse. Unposting removes a quote from the public feed without deleting it from My Quotes.

    if posts.length === 0
      p.empty_state You haven't posted any quotes yet.

    div.quote_grid
      each post in posts
        div.quote_card
          span.heart_form.heart_static
            span.heart_icon ♡
            span.heart_count= post.like_count

          p.quote_text "#{post.quote_text}"
          p.quote_source #{post.source}
          hr
          p.quote_author + Folio'd #{post.foliod_count}
          div.quote_actions
            form(action='/unpost/' + post.post_id, method='post')
              input(type='submit', value='Unpost').unpost_button

    p.add_quote_link
      a(href='/folio') Back to My Quotes
